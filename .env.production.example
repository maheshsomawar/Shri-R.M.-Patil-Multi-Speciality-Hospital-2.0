# Production Environment Template — Shri R.M. Patil Multi Speciality Hospital 2.0
# Copy to .env on your production server and replace EVERY placeholder before starting.
# NEVER commit .env to GitHub.

# Network & Proxy (Use 0.0.0.0 inside Docker; 127.0.0.1 if running directly on Linux host behind Caddy)
HOST=0.0.0.0
PORT=8080
DEBUG=false
TRUST_PROXY=true
SECURE_COOKIES=true
MAX_WORKERS=64

# Public Domain & Strict CORS (Remove localhost in production)
PUBLIC_BASE_URL=https://shrirmppatilhospital.in
ALLOWED_ORIGINS=https://shrirmppatilhospital.in,https://www.shrirmppatilhospital.in

# Rate Limiting (per real client IP via Caddy X-Real-IP)
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_BOOKING=15
RATE_LIMIT_LOGIN=10

# Cryptographic Session Secret (Generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=replace_with_64_char_random_hex_secret

# Live Razorpay Payment Gateway (Switch from rzp_test_ to rzp_live_ only after KYC approval)
RAZORPAY_KEY_ID=replace_with_rzp_live_key_id
RAZORPAY_KEY_SECRET=replace_with_rzp_live_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# India TRAI DLT Transactional SMS Gateway (MSG91 / Fast2SMS)
SMS_PROVIDER=msg91
SMS_GATEWAY_API_KEY=replace_with_live_sms_api_key
SMS_DLT_ENTITY_ID=replace_with_trai_dlt_entity_id
SMS_DLT_TEMPLATE_ID=replace_with_trai_dlt_template_id
SMS_SENDER_ID=RMPHSP

# Staff Password-Recovery Email (Gmail App Password or Brevo/Resend SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_with_hospital_gmail@gmail.com
SMTP_PASSWORD=replace_with_gmail_app_password

# Initial Staff Passwords (Rotate to strong unique 20+ char passwords before launch)
ADMIN_PASSWORD=change_me_strong_admin_password
DR_ROHAN_PASSWORD=change_me_strong_dr_rohan_password
DR_RAHUL_PASSWORD=change_me_strong_dr_rahul_password
DR_MANJUSHA_PASSWORD=change_me_strong_dr_manjusha_password
DR_SNEHAL_PASSWORD=change_me_strong_dr_snehal_password
RECEPTION_PASSWORD=change_me_strong_reception_password
NURSE_PASSWORD=change_me_strong_nurse_password
PHARMACIST_PASSWORD=change_me_strong_pharmacist_password
LAB_TECH_PASSWORD=change_me_strong_lab_tech_password
BILLING_PASSWORD=change_me_strong_billing_password
