# Copy this file to .env and fill in strong production values.
# NEVER commit .env to Git!
HOST=127.0.0.1
PORT=8080
DEBUG=false
SECURE_COOKIES=true

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_with_64_char_hex_secret_from_secrets_token_hex

# External API keys stay strictly on the server (never exposed to browser JS)
SMS_GATEWAY_API_KEY=replace_with_real_sms_gateway_key

# Strict comma-separated CORS allowlist (no wildcard '*')
ALLOWED_ORIGINS=https://shrirmppatilhospital.in,http://127.0.0.1:8080

# Rate limits (requests per 60-second sliding window per IP)
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_BOOKING=15
RATE_LIMIT_LOGIN=10

# Initial Staff Passwords (hashed with scrypt on first boot)
ADMIN_PASSWORD=change_me_strong_admin_password
DR_ROHAN_PASSWORD=change_me_dr_rohan_password
DR_RAHUL_PASSWORD=change_me_dr_rahul_password
DR_MANJUSHA_PASSWORD=change_me_dr_manjusha_password
DR_SNEHAL_PASSWORD=change_me_dr_snehal_password
RECEPTION_PASSWORD=change_me_reception_password

# Payment Provider (Razorpay Test Mode ONLY during development — never commit real live keys!)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
NURSE_PASSWORD=change_me_nurse_password
PHARMACIST_PASSWORD=change_me_pharmacist_password
LAB_TECH_PASSWORD=change_me_lab_tech_password
BILLING_PASSWORD=change_me_billing_password
